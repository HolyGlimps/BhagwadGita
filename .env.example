# .env.example

# Bhagavad Gita API (RapidAPI)
NEXT_PUBLIC_API_BASE_URL=https://bhagavad-gita3.p.rapidapi.com
RAPID_API_KEY=your_api_key_here
RAPID_API_HOST=bhagavad-gita3.p.rapidapi.com

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-use-openssl-rand-base64-32

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Supabase/PostgreSQL Database
DATABASE_URL=postgresql://user:password@supabase.host:5432/postgres